@@ -0,0 +1,53 @@
+import type { CliAdapter, SpawnContext } from '../cli-adapter.js';
+import { emptyAgentSessionRuntime } from '../cli-adapter.js';
+
+/**
+ * DSH (DeepSeek Harness) reached through the `dsh-bridge` shim. The bridge
+ * owns the entire agent surface — model selection, credentials, session
+ * storage, and transcript layout live inside DSH, so OpenAlice injects
+ * nothing: no `writeAiConfig`/`readAiConfig`, no transcript discovery, no
+ * AI-provider capability declaration.
+ *
+ * Session identity mirrors the pi pattern: the launcher mints a uuid on a
+ * fresh spawn (`assignsSessionId`), threads it through `composeCommand` as a
+ * create-or-reopen resume intent, and persists it as `resumeHint` immediately
+ * — reattach then resumes BY ID instead of harvesting transcripts.
+ */
+export const dshAdapter: CliAdapter = {
+  id: 'dsh',
+  displayName: 'DSH',
+  kind: 'agent',
+  binary: 'dsh-bridge',
+  // c=claude, x=codex, o=opencode, p=pi, sh=shell taken; 'd' is free.
+  namePrefix: 'd',
+  capabilities: {
+    parallelPerCwd: true,
+    resumeLast: true,
+    resumeById: true,
+    transcriptDiscovery: 'none',
+    headless: true,
+    // The bridge accepts a launcher-assigned session id at spawn
+    // (create-or-reopen), so the id is recorded without disk-watching.
+    assignsSessionId: true,
+  },
+
+  // DSH manages its own credentials; there is no Workspace AI binding to
+  // project into argv or env.
+  sessionRuntime: emptyAgentSessionRuntime,
+
+  composeCommand(base: readonly string[], ctx: SpawnContext): readonly string[] {
+    if (ctx.resume === undefined) return [...base];
+    if (ctx.resume === 'last') return [...base, '--continue'];
+    return [...base, '--resume', ctx.resume.sessionId];
+  },
+
+  // Headless: one-shot mode — the bridge consumes the prompt and exits at the
+  // turn boundary.
+  composeHeadlessCommand(
+    base: readonly string[],
+    _ctx: SpawnContext,
+    prompt: string,
+  ): readonly string[] {
+    return [...base, '--prompt', prompt];
+  },
+};
